# ─────────────────────────────────────────────────────────────
# Chép file này thành .env rồi điền giá trị:
#   cp .env.example .env           (Git Bash)
#   Copy-Item .env.example .env    (PowerShell)
#
# Biến đánh dấu (BẮT BUỘC) mà thiếu thì app từ chối khởi động ngay lúc boot
# — Joi kiểm định trong src/configs/config.module.ts.
# ─────────────────────────────────────────────────────────────

# ── Ứng dụng ──
NODE_ENV=development
PORT=8080

# ── Database (BẮT BUỘC) ──
DATABASE_URL="postgresql://postgres:matkhau@localhost:5432/elegant_shop?schema=public"

# ── JWT ──
# JWT_SECRET (BẮT BUỘC): đổi thành chuỗi ngẫu nhiên thật dài, đừng dùng lại giá trị mẫu.
JWT_SECRET=thay-bang-chuoi-ngau-nhien-that-dai
JWT_EXPIRES_IN=1d
# Bỏ trống JWT_REFRESH_SECRET thì hệ thống dùng lại JWT_SECRET để ký refresh token.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary (BẮT BUỘC) ──
# Chỉ phục vụ upload ảnh/file của FAQ. Muốn chạy thử nhanh thì cứ để nguyên giá trị
# giả bên dưới: app vẫn khởi động bình thường, chỉ riêng tính năng upload là hỏng.
# Khoá thật lấy tại https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=cloud-gia
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=khoa-gia

# ── Email SMTP (BẮT BUỘC) ──
# Email chào mừng và email xác nhận đơn hàng đều gửi kiểu fire-and-forget
# (auth.service.ts:146, order.service.ts:574), nên SMTP hỏng KHÔNG chặn đăng ký
# hay đặt hàng. Giá trị giả bên dưới đủ để chạy trọn luồng thử nghiệm.
# Dùng Gmail thật thì MAIL_PASSWORD phải là app password, không phải mật khẩu tài khoản.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=khong-dung-that@example.com
MAIL_PASSWORD=mat-khau-gia
MAIL_FROM=khong-dung-that@example.com
MAIL_SECURE=false
MAIL_IGNORE_TLS=false

# ── Tài khoản admin tạo tự động lúc khởi động (tuỳ chọn) ──
# Thiếu cả ba biến này thì InitService bỏ qua, không tạo admin nào.
# Mật khẩu được in ra console ở lần khởi động đầu tiên — nhớ chép lại.
DEFAULT_ADMIN_EMAIL=admin@elegantshop.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@123456
